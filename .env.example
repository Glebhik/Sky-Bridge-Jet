# Development-only values. Copy this file to the repository-root .env.
# Host commands read DATABASE_HOST=localhost; Compose overrides it to db.
DATABASE_NAME=sky_bridge_jet
DATABASE_USER=sky_bridge_jet
DATABASE_PASSWORD=sky_bridge_jet_dev_only
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Optional override. When non-empty, DATABASE_URL takes precedence over all
# component variables. Leave blank to construct a URL safely from the fields above.
DATABASE_URL=
# Server-only upstream API origin for the web app's same-origin proxy. It is read ONLY
# on the server (never a NEXT_PUBLIC_* value) and never reaches the browser bundle. For
# host development the API runs on localhost:8000, so this is that origin. Under Docker
# Compose the web container instead defaults to http://api:8000 (the `api` service DNS
# name); set WEB_API_UPSTREAM_ORIGIN to override that Compose-specific value if needed.
API_UPSTREAM_ORIGIN=http://localhost:8000
# Public Customer Portal demonstration preview. Server-only and fail-closed: absent or
# any value other than the exact string "true" makes every /demo route return 404. Never
# rename this to NEXT_PUBLIC_* or expose it through request-controlled input.
DEMO_PORTAL_ENABLED=false
LOG_LEVEL=INFO

# Stripe Connect (Phase 7) — DISABLED by default. The app boots and all tests run
# with these blank, using the provider-neutral fake adapter. TEST MODE ONLY: when
# enabled, a secret key AND a webhook secret are required, and a live key
# (sk_live_/rk_live_) is rejected while STRIPE_TEST_MODE_REQUIRED=true. Never commit
# real secret values to this file — supply them via the environment.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_TEST_MODE_REQUIRED=true
STRIPE_ACCOUNT_COUNTRY=IE

# Identity & sessions (Phase 8). Cookies are HttpOnly/SameSite with a bounded
# lifetime. SESSION_COOKIE_SECURE defaults to on in production and off in
# development/test (plain http); it must not be disabled in production. To bootstrap
# the first product owner, run:
#   uv run python -m sky_bridge_jet.modules.iam.bootstrap --email owner@example.com
# supplying the password via SBJ_BOOTSTRAP_PASSWORD (never a committed default).
# SESSION_COOKIE_SECURE=
# SESSION_TTL_SECONDS=43200
# AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
# AUTH_RATE_LIMIT_WINDOW_SECONDS=60
