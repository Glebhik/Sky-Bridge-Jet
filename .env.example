# Development-only values. Copy this file to the repository-root .env.
# Host commands read DATABASE_HOST=localhost; Compose overrides it to db.
DATABASE_NAME=sky_bridge_jet
DATABASE_USER=sky_bridge_jet
DATABASE_PASSWORD=sky_bridge_jet_dev_only
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Optional override. When non-empty, DATABASE_URL takes precedence over all
# component variables. Leave blank to construct a URL safely from the fields above.
DATABASE_URL=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
